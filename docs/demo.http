### Коллекция VS Code REST Client / JetBrains HTTP Client.
### Подставляйте id и lock_version из ответов; HTTP-клиент должен сохранять cookies.
@base = http://localhost:8000/api/v1
@csrf = replace-with-token-from-response
@password = replace-with-DEMO_PASSWORD
@application = replace-with-application-uuid
@offer = replace-with-offer-uuid
@agreement = replace-with-agreement-uuid
@version = 0
@hash = replace-with-document-hash
@document = replace-with-original-document-uuid
@pdf_hash = replace-with-pdf-sha256
@signature_attempt = replace-with-attempt-uuid
@demo_code = replace-with-server-demo-code-do-not-log
@conversation = replace-with-conversation-uuid
@conversation_version = 0

### Получить cookie и CSRF-токен
GET {{base}}/session/csrf/

### Войти. После входа обновите @csrf из ответа.
POST {{base}}/session/login/
Content-Type: application/json
X-CSRFToken: {{csrf}}

{"username":"client","password":"{{password}}"}

### Полномочия
GET {{base}}/me/

### Компании
GET {{base}}/companies/

### Продукты
GET {{base}}/products/

### Учебная стоимость по каталогу: ставка/границы берутся с сервера, заявка не создаётся.
### Ответ: cost_breakdown, schedule, annual_rate, catalog_version. Не передавайте annual_rate вместе с product.
POST {{base}}/calculator/payment/
Content-Type: application/json
X-CSRFToken: {{csrf}}

{"product":"00000000-0000-0000-0000-000000000065","amount":"1500000.00","term_months":24}

### Создать черновик. UUID совпадают с seeds.
POST {{base}}/applications/
Content-Type: application/json
X-CSRFToken: {{csrf}}

{"company":"00000000-0000-0000-0000-000000000001","product":"00000000-0000-0000-0000-000000000065","amount":"1000000.00","term_months":24,"purpose":"Оборотные средства","monthly_revenue":"1500000.00","monthly_expenses":"900000.00","monthly_debt_payments":"50000.00"}

### Отправить. Обновите @version из ответа.
POST {{base}}/applications/{{application}}/submit/
Content-Type: application/json
X-CSRFToken: {{csrf}}

{"lock_version":{{version}}}

### Карточка с ревизиями, проверками и решениями
GET {{base}}/applications/{{application}}/

### Смена роли: logout, GET csrf, login с username=specialist
POST {{base}}/session/logout/
X-CSRFToken: {{csrf}}

### Очередь специалиста
GET {{base}}/staff/applications/?status=review&assignment=free&ordering=created_at

### Взять в работу. Только текущий специалист, затем обновите @version из ответа.
POST {{base}}/staff/applications/{{application}}/claim/
Content-Type: application/json
X-CSRFToken: {{csrf}}

{"lock_version":{{version}}}

### Мои заявки; риск может быть null. Нет Grade/SLA/приоритета.
GET {{base}}/staff/applications/?assignment=mine&risk_level=low

### Решение специалиста
POST {{base}}/staff/applications/{{application}}/decide/
Content-Type: application/json
X-CSRFToken: {{csrf}}

{"lock_version":{{version}}}

### После входа клиентом — принять предложение
### Сначала прочитайте comparison/cost_breakdown и проверьте source_revision_id.
GET {{base}}/offers/{{offer}}/

### Принять прочитанное предложение с актуальным lock_version.
POST {{base}}/offers/{{offer}}/accept/
Content-Type: application/json
X-CSRFToken: {{csrf}}

{"lock_version":{{version}}}

### Сформировать исходный PDF: права can_sign, источник — сохранённый снимок.
POST {{base}}/agreements/{{agreement}}/generate-document/
Content-Type: application/json
X-CSRFToken: {{csrf}}

{"lock_version":{{version}},"document_hash":"{{hash}}"}

### Прочитать @document/@pdf_hash из ответа, открыть и скачать те же байты.
GET {{base}}/agreements/{{agreement}}/pdf/?kind=original&download=true

### Только после явного ознакомления: начать демо-попытку. SMS НЕ отправляется.
### @signature_attempt/@demo_code — из этого ответа; код не помещать в отчёты/логи.
POST {{base}}/agreements/{{agreement}}/signature-attempt/
Content-Type: application/json
X-CSRFToken: {{csrf}}

{"lock_version":{{version}},"document_hash":"{{hash}}","document_id":"{{document}}","pdf_sha256":"{{pdf_hash}}","acknowledged":true,"confirm_simulation":true}

### Подтвердить код: это ещё НЕ выдача. Старый hash-only запрос отклоняется.
POST {{base}}/agreements/{{agreement}}/sign/
Content-Type: application/json
X-CSRFToken: {{csrf}}

{"lock_version":{{version}},"document_hash":"{{hash}}","document_id":"{{document}}","pdf_sha256":"{{pdf_hash}}","attempt_id":"{{signature_attempt}}","code":"{{demo_code}}","confirm_simulation":true}

### После чтения новой версии карточки: отдельная копия, без повторной подписи.
POST {{base}}/agreements/{{agreement}}/signed-document/
Content-Type: application/json
X-CSRFToken: {{csrf}}

{"lock_version":{{version}},"document_hash":"{{hash}}"}

### После входа специалистом — моделируемая выдача. Ключ сохраните для повтора.
### Специалист должен оставаться исполнителем; после sign загрузите карточку для новой @version.
POST {{base}}/agreements/{{agreement}}/disburse/
Content-Type: application/json
X-CSRFToken: {{csrf}}
Idempotency-Key: 11111111-1111-4111-8111-111111111111

{"lock_version":{{version}}}

### История
GET {{base}}/applications/{{application}}/events/

### Дополнительная ветка — запрос специалиста
POST {{base}}/staff/applications/{{application}}/request-information/
Content-Type: application/json
X-CSRFToken: {{csrf}}

{"lock_version":{{version}},"question":"Уточните месячную выручку, расходы и обязательства"}

### Ответ клиента новой ревизией
POST {{base}}/applications/{{application}}/provide-information/
Content-Type: application/json
X-CSRFToken: {{csrf}}

{"lock_version":{{version}},"amount":"1000000.00","term_months":24,"purpose":"Оборотные средства","monthly_revenue":"1500000.00","monthly_expenses":"900000.00","monthly_debt_payments":"50000.00"}

### Повтор технической проверки
POST {{base}}/applications/{{application}}/retry-checks/
Content-Type: application/json
X-CSRFToken: {{csrf}}

{"lock_version":{{version}}}

### Освободить свою заявку (альтернативная ветка до завершения). Новый @version из ответа.
POST {{base}}/staff/applications/{{application}}/release/
Content-Type: application/json
X-CSRFToken: {{csrf}}

{"lock_version":{{version}}}

### После 409 — только обновить карточку и проверить данные пользователем, без автоматического повтора.
GET {{base}}/staff/applications/{{application}}/

### Савелий (клиент, AI_ENABLED=true и настроенная модель). Только синтетические данные.
POST {{base}}/assistant/conversations/
Content-Type: application/json
X-CSRFToken: {{csrf}}

{"company_id":"00000000-0000-0000-0000-000000000001"}

### Обновите @conversation из ответа и @conversation_version после каждого ответа.
POST {{base}}/assistant/conversations/{{conversation}}/messages/
Content-Type: application/json
X-CSRFToken: {{csrf}}

{"text":"Нужен миллион на закупку товара на год","expected_version":{{conversation_version}}}

### Проверить историю после неопределённого результата, без автоматического повтора.
GET {{base}}/assistant/conversations/{{conversation}}/messages/

### Явное удаление собственного диалога и переписки (204).
DELETE {{base}}/assistant/conversations/{{conversation}}/
X-CSRFToken: {{csrf}}
