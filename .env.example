# Copy to .env and set DJANGO_SECRET_KEY, DB_PASSWORD and DEMO_PASSWORD locally.
# Never commit real credentials. Selected stack and release boundaries: docs/stack.md.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Set true for local runserver; Compose explicitly overrides this to false.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Vite/Nginx preserve the browser Host: same-origin local HTTP needs no extra origins.
# For public HTTPS, configure the domain/full trusted origins and secure cookies.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_COOKIE_SECURE=false

# Compose publishes HTTP on loopback only: backend 8000, frontend 8080.
WEB_PORT=8000
FRONTEND_PORT=8080

# Local PostgreSQL. Compose uses its own db service and overrides these to db:5432.
# Port 55432 is PostgreSQL, not the frontend's HTTP API target.
DB_NAME=alfa_credit
DB_USER=alfa_credit
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=55432

# Synthetic demo data only. seed_demo requires a password passing Django validation.
DEMO_MODE=true
# Choose a local demo password (12+ characters); never reuse a real account password.
DEMO_PASSWORD=

# Optional Saveliy assistant. The credit workflow works with both flags disabled.
# Public compile-time UI flag; no secrets in VITE_* variables.
VITE_AI_ASSISTANT_ENABLED=false
# Server-side flag; answers also require a reachable OpenAI-compatible endpoint.
AI_ENABLED=false
LLM_PROVIDER=compatible
# Docker Desktop -> host Ollama; native Django: http://127.0.0.1:11434/v1.
# On Linux Docker, configure a reachable host address for your environment.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:7b-instruct-q4_0
# Only set locally if required by the endpoint. Never expose this to the frontend.
LLM_API_KEY=
# Optional comma-separated model names at the main endpoint.
LLM_FALLBACK_MODELS=
# Optional separate local fallback endpoint; empty means no separate fallback.
LLM_LOCAL_FALLBACK_BASE_URL=
LLM_LOCAL_FALLBACK_MODEL=qwen2.5:7b-instruct-q4_0
# Backend clamps the timeout to 1-40 seconds.
LLM_TIMEOUT_SECONDS=40
