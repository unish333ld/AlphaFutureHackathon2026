# Local jury demo only. These public defaults must never be used on an internet-facing deployment.
DJANGO_SECRET_KEY=local-only-insecure-key-do-not-use-publicly-alfa-credit-jury-demo-2026
# Set true for local runserver; Compose explicitly overrides this to false.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Vite/Nginx preserve the browser Host: same-origin local HTTP needs no extra origins.
# For public HTTPS, configure the domain/full trusted origins and secure cookies.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_COOKIE_SECURE=false

# Compose publishes HTTP on loopback only: backend 8000, frontend 8080.
WEB_PORT=8000
FRONTEND_PORT=8080

# Local PostgreSQL. Compose uses its own db service and overrides these to db:5432.
# Port 55432 is PostgreSQL, not the frontend's HTTP API target.
DB_NAME=alfa_credit
DB_USER=alfa_credit
DB_PASSWORD=local-demo-db-only-2026
DB_HOST=127.0.0.1
DB_PORT=55432

# Synthetic demo data only. seed_demo requires a password passing Django validation.
DEMO_MODE=true
# Insecure demo-code simulator only; no SMS, phone or real electronic signature.
# Requires DEMO_MODE=true. Set false to disable new signing attempts.
DEMO_SIGNATURE_ENABLED=true
# Shared password for synthetic accounts client, specialist, accountant and outsider.
DEMO_PASSWORD=AlfaHack2026!Demo

# Optional Saveliy assistant. The credit workflow works with both flags disabled.
# Public compile-time UI flag; no secrets in VITE_* variables.
VITE_AI_ASSISTANT_ENABLED=false
# Server-side flag; answers also require a reachable OpenAI-compatible endpoint.
AI_ENABLED=false
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Only set locally if required by the endpoint. Never expose this to the frontend.
LLM_API_KEY=
# Standard OpenRouter key alias, used only with LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# Reject paid slugs and cap OpenRouter prompt/completion/request prices at zero.
LLM_OPENROUTER_FREE_ONLY=true
# OpenRouter only: optional explicit comma-separated fallback model names.
LLM_FALLBACK_MODELS=
# Optional local fallback; install Ollama/model separately (docs/assistant.md).
# Docker Desktop -> host; native Django uses http://127.0.0.1:11434/v1.
# On Linux Docker use a reachable host address. Empty URL disables the fallback.
LLM_LOCAL_FALLBACK_BASE_URL=http://host.docker.internal:11434/v1
LLM_LOCAL_FALLBACK_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Backend clamps the timeout to 1-40 seconds.
LLM_TIMEOUT_SECONDS=25
LLM_TOTAL_TIMEOUT_SECONDS=75
LLM_MAX_OUTPUT_TOKENS=768
LLM_MAX_CONTEXT_CHARS=16000
AI_MAX_MESSAGE_LENGTH=2000
AI_USER_RATE=10/min
# Inactive history expires after this period; purge_assistant_history deletes it.
AI_HISTORY_DAYS=7
