# Generate a local key: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Selected stack and release boundaries: docs/stack.md.
# Django session cookies + CSRF; serve frontend/API under one origin. No backend LLM in this release.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_COOKIE_SECURE=false
WEB_PORT=8000
FRONTEND_PORT=8080
# Public compile-time flag; no secrets in VITE_* variables.
VITE_AI_ASSISTANT_ENABLED=false
DB_NAME=alfa_credit
DB_USER=alfa_credit
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=55432
DEMO_MODE=true
# Choose a local demo password (12+ characters), used by seed_demo.
DEMO_PASSWORD=
