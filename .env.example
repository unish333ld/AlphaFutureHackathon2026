# Generate a local key: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_COOKIE_SECURE=false
WEB_PORT=8000
DB_NAME=alfa_credit
DB_USER=alfa_credit
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=55432
DEMO_MODE=true
# Choose a local demo password (12+ characters), used by seed_demo.
DEMO_PASSWORD=

# Optional assistant. The credit workflow works with AI_ENABLED=false.
# Start an open-weight model separately and point this URL to its OpenAI-compatible /v1 API.
AI_ENABLED=false
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b-instruct-q4_0
LLM_TIMEOUT_SECONDS=40
