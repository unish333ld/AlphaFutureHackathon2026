{
  "name": "alfa-credit-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b tsconfig.json tsconfig.tools.json --pretty false",
    "api:generate": "openapi-typescript ../docs/openapi.yaml -o src/shared/api/schema.d.ts && prettier --write src/shared/api/schema.d.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "format": "prettier --write src tests *.ts *.json",
    "format:check": "prettier --check src tests *.ts *.json"
  },
  "dependencies": {
    "@alfalab/core-components": "50.38.0",
    "@alfalab/core-components-config": "1.1.0",
    "@alfalab/core-components-stack-context": "1.0.1",
    "@alfalab/icons-glyph": "2.293.3",
    "@alfalab/icons-logotype": "2.37.3",
    "@hookform/resolvers": "5.2.2",
    "@tanstack/react-query": "5.104.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.91.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
